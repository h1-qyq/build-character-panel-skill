{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/build-character-panel/character-profile.schema.json",
  "title": "Character Profile",
  "description": "Portable evidence-aware RPG character panel data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "domains",
    "core_attributes",
    "traits",
    "skills",
    "resources",
    "quests",
    "status_effects",
    "unknowns",
    "conflicts",
    "next_unlocks",
    "provenance",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "language",
        "archetype",
        "current_chapter",
        "completeness"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "archetype": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "level_system": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeness": {
          "enum": [
            "quick",
            "full"
          ]
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "core_attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ratedItem"
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trait"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "status_effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statusEffect"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "next_unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "language",
        "sources"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "language": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "user",
                  "artifact",
                  "interview",
                  "prior-profile",
                  "other"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "updated_at",
        "change_summary"
      ],
      "properties": {
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "change_summary": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary",
        "source"
      ],
      "properties": {
        "state": {
          "enum": [
            "stated",
            "observed",
            "inferred",
            "unknown",
            "conflicted"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "summary",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "known",
            "partial",
            "unknown",
            "conflicted"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "ratedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "score",
        "confidence",
        "evidence",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "summary",
        "confidence",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "trait",
            "value",
            "preference",
            "boundary"
          ]
        },
        "summary": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "level",
        "confidence",
        "evidence",
        "next_unlock"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "next_unlock": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "summary",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "tool",
            "credential",
            "network",
            "time",
            "capital",
            "asset",
            "environment",
            "constraint"
          ]
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "status",
        "stakes",
        "next_action",
        "blocker",
        "success_signal",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "planned",
            "blocked",
            "complete"
          ]
        },
        "stakes": {
          "type": "string"
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_signal": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "statusEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "effect",
        "scope",
        "recovery",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "effect": {
          "enum": [
            "buff",
            "debuff",
            "mixed"
          ]
        },
        "scope": {
          "type": "string"
        },
        "recovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "accounts",
        "resolution"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "accounts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
